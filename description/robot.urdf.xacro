<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot">

    <xacro:arg name="use_ros2_control" default="true"/>
    <xacro:arg name="sim_mode" default="true"/>
    <xacro:arg name="use_hardware" default="false"/>

    <xacro:include filename="robot_core.xacro" />

    <!-- Control system selection -->
    <xacro:if value="$(arg use_hardware)">
        <!-- Hardware mode: Use SparkFlex ros2_control hardware interface -->
        <ros2_control name="RealRobot" type="system">
            <hardware>
                <plugin>sparkflex_ros2_control/SparkFlexHardwareInterface</plugin>
                <param name="can_interface">can0</param>
                <param name="update_rate">100</param>
                <param name="config_file">$(find lunabot_one)/hardware/sparkflex/motor_params.yaml</param>
                <param name="can_ids_file">$(find lunabot_one)/hardware/can/sparkflex_can_ids.yaml</param>
            </hardware>

            <!-- Rear wheels (left side) -->
            <joint name="left_wheel_joint">
                <command_interface name="velocity">
                    <param name="min">-5700.0</param>
                    <param name="max">5700.0</param>
                </command_interface>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="sparkflex_can_ids">[3]</param>  <!-- Rear left -->
                <param name="gear_ratio">1.0</param>
                <param name="wheel_radius">0.1778</param>
                <param name="direction_multiplier">1.0</param>
                <param name="motor_type">NEO</param>
            </joint>

            <!-- Rear wheels (right side) -->
            <joint name="right_wheel_joint">
                <command_interface name="velocity">
                    <param name="min">-5700.0</param>
                    <param name="max">5700.0</param>
                </command_interface>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="sparkflex_can_ids">[4]</param>  <!-- Rear right -->
                <param name="gear_ratio">1.0</param>
                <param name="wheel_radius">0.1778</param>
                <param name="direction_multiplier">-1.0</param>
                <param name="motor_type">NEO</param>
            </joint>

            <!-- Front wheels (left side) -->
            <joint name="left_front_wheel_joint">
                <command_interface name="velocity">
                    <param name="min">-5700.0</param>
                    <param name="max">5700.0</param>
                </command_interface>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="sparkflex_can_ids">[1]</param>  <!-- Front left -->
                <param name="gear_ratio">1.0</param>
                <param name="wheel_radius">0.1778</param>
                <param name="direction_multiplier">1.0</param>
                <param name="motor_type">NEO</param>
            </joint>

            <!-- Front wheels (right side) -->
            <joint name="right_front_wheel_joint">
                <command_interface name="velocity">
                    <param name="min">-5700.0</param>
                    <param name="max">5700.0</param>
                </command_interface>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <param name="sparkflex_can_ids">[2]</param>  <!-- Front right -->
                <param name="gear_ratio">1.0</param>
                <param name="wheel_radius">0.1778</param>
                <param name="direction_multiplier">-1.0</param>
                <param name="motor_type">NEO</param>
            </joint>
        </ros2_control>
    </xacro:if>

    <xacro:unless value="$(arg use_hardware)">
        <!-- Simulation mode: Use existing control systems -->
        <xacro:if value="$(arg use_ros2_control)">
            <xacro:include filename="ros2_control.xacro" />
        </xacro:if>
        <xacro:unless value="$(arg use_ros2_control)">
            <xacro:include filename="gazebo_control.xacro" />
        </xacro:unless>
    </xacro:unless>

    <!-- Sensors -->
    <xacro:include filename="lidar.xacro" />
    
    <!-- Simulation-only sensors -->
    <xacro:if value="$(arg sim_mode)">
        <!-- <xacro:include filename="camera.xacro" /> -->
        <xacro:include filename="depth_camera.xacro" />
        <xacro:include filename="imu.xacro" />
    </xacro:if>

    <xacro:include filename="face.xacro" />
    
</robot>
