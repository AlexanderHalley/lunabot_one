<sdf version='1.10'>
  <world name='rocky_terrain'>
    <physics name='1ms' type='ignored'>
      <max_step_size>0.05</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>
    
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>5.5e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Main ground plane (flat, like original) -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.7 0.5 1</ambient>
            <diffuse>0.8 0.7 0.5 1</diffuse>
            <specular>0.8 0.7 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Small rocks scattered around -->
    <model name='rock_1'>
      <pose>3 2 0.1 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <sphere><radius>0.2</radius></sphere>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <sphere><radius>0.2</radius></sphere>
          </geometry>
          <material>
            <diffuse>0.4 0.4 0.4 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name='rock_2'>
      <pose>-2 3 0.15 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <box><size>0.3 0.2 0.3</size></box>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <box><size>0.3 0.2 0.3</size></box>
          </geometry>
          <material>
            <diffuse>0.5 0.4 0.3 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name='rock_3'>
      <pose>5 -3 0.12 0 0.2 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <sphere><radius>0.24</radius></sphere>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <sphere><radius>0.24</radius></sphere>
          </geometry>
          <material>
            <diffuse>0.3 0.3 0.3 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name='rock_4'>
      <pose>-4 -2 0.08 0 0 0.5</pose>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <box><size>0.4 0.15 0.16</size></box>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <box><size>0.4 0.15 0.16</size></box>
          </geometry>
          <material>
            <diffuse>0.45 0.35 0.25 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name='rock_5'>
      <pose>1 -5 0.18 0.1 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <cylinder><radius>0.25</radius><length>0.36</length></cylinder>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <cylinder><radius>0.25</radius><length>0.36</length></cylinder>
          </geometry>
          <material>
            <diffuse>0.4 0.3 0.2 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Sun lighting -->
    <light name='sun' type='directional'>
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    
  </world>
</sdf>