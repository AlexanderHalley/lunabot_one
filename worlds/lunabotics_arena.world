<sdf version='1.10'>
  <world name='lunabotics_arena'>
    <physics name='1ms' type='ignored'>
      <max_step_size>0.05</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>
    
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>5.5e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.8 0.8 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Arena floor (BP-1 regolith simulant) -->
    <model name='arena_floor'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <box><size>6.8 5.0 0.1</size></box>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <box><size>6.8 5.0 0.1</size></box>
          </geometry>
          <material>
            <diffuse>0.2 0.15 0.1 1.0</diffuse> <!-- Dark basalt color -->
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
        <pose>0 0 -0.05 0 0 0</pose>
      </link>
    </model>

    <!-- Arena walls -->
    <model name='north_wall'>
      <pose>0 2.5 0.25 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <box><size>6.8 0.1 0.5</size></box>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <box><size>6.8 0.1 0.5</size></box>
          </geometry>
          <material>
            <diffuse>0.8 0.8 0.8 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name='south_wall'>
      <pose>0 -2.5 0.25 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <box><size>6.8 0.1 0.5</size></box>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <box><size>6.8 0.1 0.5</size></box>
          </geometry>
          <material>
            <diffuse>0.8 0.8 0.8 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name='east_wall'>
      <pose>3.4 0 0.25 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <box><size>0.1 5.0 0.5</size></box>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <box><size>0.1 5.0 0.5</size></box>
          </geometry>
          <material>
            <diffuse>0.8 0.8 0.8 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name='west_wall'>
      <pose>-3.4 0 0.25 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <box><size>0.1 5.0 0.5</size></box>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <box><size>0.1 5.0 0.5</size></box>
          </geometry>
          <material>
            <diffuse>0.8 0.8 0.8 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Perimeter ducting (17cm diameter) -->
    <model name='north_duct'>
      <pose>0 2.32 0.085 0 1.57 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <cylinder><radius>0.085</radius><length>6.8</length></cylinder>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <cylinder><radius>0.085</radius><length>6.8</length></cylinder>
          </geometry>
          <material>
            <diffuse>0.6 0.6 0.6 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name='south_duct'>
      <pose>0 -2.32 0.085 0 1.57 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <cylinder><radius>0.085</radius><length>6.8</length></cylinder>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <cylinder><radius>0.085</radius><length>6.8</length></cylinder>
          </geometry>
          <material>
            <diffuse>0.6 0.6 0.6 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name='east_duct'>
      <pose>3.22 0 0.085 1.57 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <cylinder><radius>0.085</radius><length>5.0</length></cylinder>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <cylinder><radius>0.085</radius><length>5.0</length></cylinder>
          </geometry>
          <material>
            <diffuse>0.6 0.6 0.6 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name='west_duct'>
      <pose>-3.22 0 0.085 1.57 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <cylinder><radius>0.085</radius><length>5.0</length></cylinder>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <cylinder><radius>0.085</radius><length>5.0</length></cylinder>
          </geometry>
          <material>
            <diffuse>0.6 0.6 0.6 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Central infrastructure support column -->
    <model name='central_column'>
      <pose>0 0 0.4 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <cylinder><radius>0.15</radius><length>0.8</length></cylinder>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <cylinder><radius>0.15</radius><length>0.8</length></cylinder>
          </geometry>
          <material>
            <diffuse>0.7 0.7 0.7 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Boulder obstacles in obstacle zone (30-40cm diameter) -->
    <model name='boulder_1'>
      <pose>-1.5 1.2 0.15 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <sphere><radius>0.175</radius></sphere>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <sphere><radius>0.175</radius></sphere>
          </geometry>
          <material>
            <diffuse>0.4 0.35 0.25 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name='boulder_2'>
      <pose>1.8 -0.8 0.2 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <box><size>0.35 0.3 0.4</size></box>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <box><size>0.35 0.3 0.4</size></box>
          </geometry>
          <material>
            <diffuse>0.3 0.3 0.2 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name='boulder_3'>
      <pose>-0.5 -1.5 0.18 0 0 0.5</pose>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <cylinder><radius>0.18</radius><length>0.36</length></cylinder>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <cylinder><radius>0.18</radius><length>0.36</length></cylinder>
          </geometry>
          <material>
            <diffuse>0.35 0.3 0.2 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Crater obstacles (simulated as shallow depressions with rim) -->
    <model name='crater_1_rim'>
      <pose>-2.5 0.5 0.03 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <cylinder><radius>0.25</radius><length>0.06</length></cylinder>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <cylinder><radius>0.25</radius><length>0.06</length></cylinder>
          </geometry>
          <material>
            <diffuse>0.25 0.2 0.15 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name='crater_2_rim'>
      <pose>2.2 1.8 0.03 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <cylinder><radius>0.22</radius><length>0.06</length></cylinder>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <cylinder><radius>0.22</radius><length>0.06</length></cylinder>
          </geometry>
          <material>
            <diffuse>0.25 0.2 0.15 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Construction zone markers (berm target area 2.2m × 0.9m) -->
    <model name='construction_zone_marker'>
      <pose>2.6 0 0.005 0 0 0</pose>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <box><size>2.2 0.9 0.01</size></box>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <box><size>2.2 0.9 0.01</size></box>
          </geometry>
          <material>
            <diffuse>1.0 0.8 0.0 0.8</diffuse> <!-- Yellow marking -->
          </material>
        </visual>
      </link>
    </model>

    <!-- Competition lighting -->
    <light name='arena_light_1' type='directional'>
      <cast_shadows>true</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 -0.2 -1</direction>
    </light>

    <light name='arena_light_2' type='directional'>
      <cast_shadows>false</cast_shadows>
      <pose>3 3 6 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 -0.5 -1</direction>
    </light>
    
  </world>
</sdf>