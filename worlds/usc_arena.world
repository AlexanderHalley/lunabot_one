<sdf version="1.6">
  <world name="usc_arena">
    <physics name="10ms" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>50</real_time_update_rate>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin 
      filename='gz-sim-imu-system'
      name='gz::sim::systems::Imu'>
    </plugin>
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Arena walls: 6.8m x 5m rectangle with SW corner at origin -->
    <!-- North wall -->
    <model name="north_wall">
      <static>true</static>
      <pose>3.4 5.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>6.8 0.1 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>6.8 0.1 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- South wall -->
    <model name="south_wall">
      <static>true</static>
      <pose>3.4 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>6.8 0.1 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>6.8 0.1 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- East wall -->
    <model name="east_wall">
      <static>true</static>
      <pose>6.8 2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 5.0 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 5.0 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- West wall -->
    <model name="west_wall">
      <static>true</static>
      <pose>0 2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 5.0 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 5.0 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Zone Boundary Visual Markings -->
    <!-- Starting Zone boundary (green L-shape) -->
    <!-- Horizontal segment: (0, 2) to (2, 2) -->
    <model name="starting_zone_horizontal">
      <static>true</static>
      <pose>1.0 2.0 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>2.0 0.02 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
            <emissive>0 0.2 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Vertical segment: (2, 2) to (2, 0) -->
    <model name="starting_zone_vertical">
      <static>true</static>
      <pose>2.0 1.0 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.02 2.0 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
            <emissive>0 0.2 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Excavation/Obstacle zone separator (black vertical line) -->
    <!-- From (2.5, 0) to (2.5, 5) -->
    <model name="excavation_obstacle_line">
      <static>true</static>
      <pose>2.5 2.5 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.02 5.0 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
            <emissive>0.1 0.1 0.1 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Construction zone boundary (black L-shape) -->
    <!-- Vertical segment: (3.88, 0) to (3.88, 1.5) -->
    <model name="construction_zone_vertical">
      <static>true</static>
      <pose>3.88 0.75 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.02 1.5 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
            <emissive>0.1 0.1 0.1 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Horizontal segment: (3.88, 1.5) to (6.88, 1.5) -->
    <model name="construction_zone_horizontal">
      <static>true</static>
      <pose>5.38 1.5 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>3.0 0.02 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
            <emissive>0.1 0.1 0.1 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Robot Spawn Area Outline (150cm x 75cm centered at 1,1) -->
    <!-- North Line -->
    <model name="robot_outline_north">
      <static>true</static>
      <pose>1.0 1.375 0.003 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>1.5 0.02 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <emissive>0.3 0 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- South Line -->
    <model name="robot_outline_south">
      <static>true</static>
      <pose>1.0 0.625 0.003 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>1.5 0.02 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <emissive>0.3 0 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- East Line -->
    <model name="robot_outline_east">
      <static>true</static>
      <pose>1.75 1.0 0.003 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.02 0.75 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <emissive>0.3 0 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- West Line -->
    <model name="robot_outline_west">
      <static>true</static>
      <pose>0.25 1.0 0.003 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.02 0.75 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <emissive>0.3 0 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Central Rectangular Column Obstacle -->
    <model name="central_column">
      <static>true</static>
      <pose>3.4 2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.4 0.4 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.4 0.4 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Boulder Obstacles in Obstacle Zone -->
    <!-- Boulder 1: Small, low height -->
    <model name="boulder_1">
      <static>true</static>
      <pose>3.0 3.5 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.15</radius>
            </sphere>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.15</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.4 0.3 0.2 1</ambient>
            <diffuse>0.4 0.3 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <inertial>
          <mass value="50"/>
          <inertia ixx="0.9" ixy="0" ixz="0" iyy="0.9" iyz="0" izz="0.9"/>
        </inertial>
      </link>
    </model>

    <!-- Boulder 2: Medium size, medium height -->
    <model name="boulder_2">
      <static>true</static>
      <pose>5.5 4.2 0.18 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.18</radius>
            </sphere>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.18</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.3 1</ambient>
            <diffuse>0.35 0.35 0.3 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <inertial>
          <mass value="75"/>
          <inertia ixx="1.5" ixy="0" ixz="0" iyy="1.5" iyz="0" izz="1.5"/>
        </inertial>
      </link>
    </model>

    <!-- Boulder 3: Large, tall -->
    <model name="boulder_3">
      <static>true</static>
      <pose>6.0 2.8 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.2</radius>
            </sphere>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.2</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.3 0.25 0.2 1</ambient>
            <diffuse>0.3 0.25 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <inertial>
          <mass value="100"/>
          <inertia ixx="2.0" ixy="0" ixz="0" iyy="2.0" iyz="0" izz="2.0"/>
        </inertial>
      </link>
    </model>

    <!-- Boulder 4: Medium-small, different position -->
    <model name="boulder_4">
      <static>true</static>
      <pose>4.5 4.5 0.16 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.16</radius>
            </sphere>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.16</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.45 0.4 0.35 1</ambient>
            <diffuse>0.45 0.4 0.35 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <inertial>
          <mass value="60"/>
          <inertia ixx="1.2" ixy="0" ixz="0" iyy="1.2" iyz="0" izz="1.2"/>
        </inertial>
      </link>
    </model>

    <!-- Waypoint Visual Markers for arena_exploration pattern -->
    <!-- Waypoint 1: (2.0, 4.2) -->
    <model name="waypoint_1">
      <static>true</static>
      <pose>2.0 4.2 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 0.5 0 0.3</ambient>
            <diffuse>0 0.5 0 0.3</diffuse>
            <emissive>0 0.1 0 0.3</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Waypoint 2: (4.75, 3.0) -->
    <model name="waypoint_2">
      <static>true</static>
      <pose>4.75 3.0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 0.5 0 0.3</ambient>
            <diffuse>0 0.5 0 0.3</diffuse>
            <emissive>0 0.1 0 0.3</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Waypoint 3: (5.0, 1.0) -->
    <model name="waypoint_3">
      <static>true</static>
      <pose>5.0 1.0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 0.5 0 0.3</ambient>
            <diffuse>0 0.5 0 0.3</diffuse>
            <emissive>0 0.1 0 0.3</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Waypoint 4: (1.0, 1.0) - Return to start -->
    <model name="waypoint_4">
      <static>true</static>
      <pose>1.0 1.0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 0.5 0 0.3</ambient>
            <diffuse>0 0.5 0 0.3</diffuse>
            <emissive>0 0.1 0 0.3</emissive>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>