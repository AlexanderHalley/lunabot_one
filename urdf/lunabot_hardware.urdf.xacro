<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lunabot_one_hardware">

    <xacro:include filename="$(find lunabot_one)/description/robot_core.xacro" />
    <xacro:include filename="$(find lunabot_one)/description/lidar.xacro" />
    
    <!-- Hardware-specific ros2_control configuration -->
    <ros2_control name="RealRobot" type="system">
        
        <!-- ODrive ROS2 Control Hardware Interface -->
        <hardware>
            <plugin>odrive_ros2_control/ODriveHardwareInterface</plugin>
            <param name="can_interface">can0</param>
            <param name="enable_watchdog">true</param>
            <param name="watchdog_timeout">1.0</param>
            <param name="update_rate">100</param>
        </hardware>
        
        <!-- Left wheel joint (combines front_left + rear_left ODrives) -->
        <joint name="left_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-10.0</param>
                <param name="max">10.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
            
            <!-- ODrive configuration for left side -->
            <param name="odrive_can_ids">[1, 3]</param>  <!-- Front left, Rear left -->
            <param name="gear_ratio">1.0</param>
            <param name="wheel_radius">0.165</param>
            <param name="direction_multiplier">1.0</param>
        </joint>
        
        <!-- Right wheel joint (combines front_right + rear_right ODrives) -->  
        <joint name="right_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-10.0</param>
                <param name="max">10.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/> 
            <state_interface name="effort"/>
            
            <!-- ODrive configuration for right side -->
            <param name="odrive_can_ids">[2, 4]</param>  <!-- Front right, Rear right -->
            <param name="gear_ratio">1.0</param>
            <param name="wheel_radius">0.165</param>
            <param name="direction_multiplier">-1.0</param>  <!-- Reverse for right side -->
        </joint>
        
    </ros2_control>

    <!-- Hardware-specific lidar configuration (no Gazebo plugins) -->
    <xacro:lidar_sensor 
        name="lidar" 
        parent="chassis"
        xyz="0.1 0 0.2" 
        rpy="0 0 0"
        hardware="true"/>

</robot>