<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lunabot_one_hardware">

    <xacro:include filename="$(find lunabot_one)/description/robot_core.xacro" />
    <xacro:include filename="$(find lunabot_one)/description/lidar.xacro" />
    
    <!-- Hardware-specific ros2_control configuration -->
    <ros2_control name="RealRobot" type="system">
        
        <!-- SparkFlex ROS2 Control Hardware Interface -->
        <hardware>
            <plugin>sparkflex_ros2_control/SparkFlexHardwareInterface</plugin>
            <param name="can_interface">can0</param>
            <param name="update_rate">100</param>
            <param name="config_file">$(find lunabot_one)/hardware/sparkflex/motor_params.yaml</param>
            <param name="can_ids_file">$(find lunabot_one)/hardware/can/sparkflex_can_ids.yaml</param>
        </hardware>

        <!-- Rear left wheel -->
        <joint name="left_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-5700.0</param>
                <param name="max">5700.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>

            <!-- SparkFlex configuration for rear left -->
            <param name="sparkflex_can_ids">[3]</param>  <!-- Rear left -->
            <param name="gear_ratio">1.0</param>
            <param name="wheel_radius">0.1778</param>
            <param name="direction_multiplier">1.0</param>
            <param name="motor_type">NEO</param>
        </joint>

        <!-- Rear right wheel -->
        <joint name="right_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-5700.0</param>
                <param name="max">5700.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>

            <!-- SparkFlex configuration for rear right -->
            <param name="sparkflex_can_ids">[4]</param>  <!-- Rear right -->
            <param name="gear_ratio">1.0</param>
            <param name="wheel_radius">0.1778</param>
            <param name="direction_multiplier">-1.0</param>  <!-- Reverse for right side -->
            <param name="motor_type">NEO</param>
        </joint>

        <!-- Front left wheel -->
        <joint name="left_front_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-5700.0</param>
                <param name="max">5700.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>

            <!-- SparkFlex configuration for front left -->
            <param name="sparkflex_can_ids">[1]</param>  <!-- Front left -->
            <param name="gear_ratio">1.0</param>
            <param name="wheel_radius">0.1778</param>
            <param name="direction_multiplier">1.0</param>
            <param name="motor_type">NEO</param>
        </joint>

        <!-- Front right wheel -->
        <joint name="right_front_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-5700.0</param>
                <param name="max">5700.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>

            <!-- SparkFlex configuration for front right -->
            <param name="sparkflex_can_ids">[2]</param>  <!-- Front right -->
            <param name="gear_ratio">1.0</param>
            <param name="wheel_radius">0.1778</param>
            <param name="direction_multiplier">-1.0</param>  <!-- Reverse for right side -->
            <param name="motor_type">NEO</param>
        </joint>
        
    </ros2_control>

    <!-- Hardware-specific lidar configuration (no Gazebo plugins) -->
    <xacro:lidar_sensor 
        name="lidar" 
        parent="chassis"
        xyz="0.1 0 0.2" 
        rpy="0 0 0"
        hardware="true"/>

</robot>